    vec3 SKY_GROUND;
#endif
void get_sky_color() {
    const vec3 SKY_TOP_NOON = ( vec3(f_NOON_SKY_T_R, f_NOON_SKY_T_G, f_NOON_SKY_T_B) * (vec3(f_NOON_SKY_T_R, f_NOON_SKY_T_G, f_NOON_SKY_T_B) * (vec3(f_NOON_SKY_T_R, f_NOON_SKY_T_G, f_NOON_SKY_T_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_TOP_SUNRISE = ( vec3(f_SUNRISE_SKY_T_R, f_SUNRISE_SKY_T_G, f_SUNRISE_SKY_T_B) * (vec3(f_SUNRISE_SKY_T_R, f_SUNRISE_SKY_T_G, f_SUNRISE_SKY_T_B) * (vec3(f_SUNRISE_SKY_T_R, f_SUNRISE_SKY_T_G, f_SUNRISE_SKY_T_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_TOP_SUNSET = ( vec3(f_SUNSET_SKY_T_R, f_SUNSET_SKY_T_G, f_SUNSET_SKY_T_B) * (vec3(f_SUNSET_SKY_T_R, f_SUNSET_SKY_T_G, f_SUNSET_SKY_T_B) * (vec3(f_SUNSET_SKY_T_R, f_SUNSET_SKY_T_G, f_SUNSET_SKY_T_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_TOP_NIGHT = ( vec3(f_NIGHT_SKY_T_R, f_NIGHT_SKY_T_G, f_NIGHT_SKY_T_B) * (vec3(f_NIGHT_SKY_T_R, f_NIGHT_SKY_T_G, f_NIGHT_SKY_T_B) * (vec3(f_NIGHT_SKY_T_R, f_NIGHT_SKY_T_G, f_NIGHT_SKY_T_B) * 0.305306011 + 0.682171111) + 0.012522878) );

    const vec3 SKY_GROUND_NOON = ( vec3(f_NOON_SKY_G_R, f_NOON_SKY_G_G, f_NOON_SKY_G_B) * (vec3(f_NOON_SKY_G_R, f_NOON_SKY_G_G, f_NOON_SKY_G_B) * (vec3(f_NOON_SKY_G_R, f_NOON_SKY_G_G, f_NOON_SKY_G_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_GROUND_SUNRISE = ( vec3(f_SUNRISE_SKY_G_R, f_SUNRISE_SKY_G_G, f_SUNRISE_SKY_G_B) * (vec3(f_SUNRISE_SKY_G_R, f_SUNRISE_SKY_G_G, f_SUNRISE_SKY_G_B) * (vec3(f_SUNRISE_SKY_G_R, f_SUNRISE_SKY_G_G, f_SUNRISE_SKY_G_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_GROUND_SUNSET = ( vec3(f_SUNSET_SKY_G_R, f_SUNSET_SKY_G_G, f_SUNSET_SKY_G_B) * (vec3(f_SUNSET_SKY_G_R, f_SUNSET_SKY_G_G, f_SUNSET_SKY_G_B) * (vec3(f_SUNSET_SKY_G_R, f_SUNSET_SKY_G_G, f_SUNSET_SKY_G_B) * 0.305306011 + 0.682171111) + 0.012522878) );
    const vec3 SKY_GROUND_NIGHT = ( vec3(f_NIGHT_SKY_G_R, f_NIGHT_SKY_G_G, f_NIGHT_SKY_G_B) * (vec3(f_NIGHT_SKY_G_R, f_NIGHT_SKY_G_G, f_NIGHT_SKY_G_B) * (vec3(f_NIGHT_SKY_G_R, f_NIGHT_SKY_G_G, f_NIGHT_SKY_G_B) * 0.305306011 + 0.682171111) + 0.012522878) );

    SKY_TOP = SKY_TOP_SUNRISE * sunriseStrength + SKY_TOP_NOON * dayStrength + SKY_TOP_SUNSET * sunsetStrength + SKY_TOP_NIGHT * nightStrength;
    SKY_GROUND = SKY_GROUND_SUNRISE * sunriseStrength + SKY_GROUND_NOON * dayStrength + SKY_GROUND_SUNSET * sunsetStrength + SKY_GROUND_NIGHT * nightStrength;

    float DesatFactor = 1 - rainStrength * RAIN_SKY_DESATURATION;
    float DarkenFactor = 1 - rainStrength * RAIN_SKY_DARKENING;
    #ifdef IS_IRIS
        DesatFactor *= 1 - thunderStrength * 0.66;
        DarkenFactor *= 1 - thunderStrength * 0.5;
    #endif

    SKY_TOP = mix_preserve_c1lum(SKY_TOP, ( skyColor.rgb * (skyColor.rgb * (skyColor.rgb * 0.305306011 + 0.682171111) + 0.012522878) ), f_BIOME_SKY_CONTRIBUTION);

    SKY_TOP = apply_saturation(SKY_TOP, DesatFactor) * DarkenFactor;
    SKY_GROUND = SKY_GROUND * DarkenFactor;
}
void get_sun_color() {

    #ifdef DIMENSION_NETHER
        SUN_AMBIENT = ( vec3(f_NETHER_AMBIENT_R, f_NETHER_AMBIENT_G, f_NETHER_AMBIENT_B) * (vec3(f_NETHER_AMBIENT_R, f_NETHER_AMBIENT_G, f_NETHER_AMBIENT_B) * (vec3(f_NETHER_AMBIENT_R, f_NETHER_AMBIENT_G, f_NETHER_AMBIENT_B) * 0.305306011 + 0.682171111) + 0.012522878) );
        SUN_DIRECT = vec3(0);
        return;
    #elif defined DIMENSION_END
        SUN_AMBIENT = ( vec3(f_END_AMBIENT_R, f_END_AMBIENT_G, f_END_AMBIENT_B) * (vec3(f_END_AMBIENT_R, f_END_AMBIENT_G, f_END_AMBIENT_B) * (vec3(f_END_AMBIENT_R, f_END_AMBIENT_G, f_END_AMBIENT_B) * 0.305306011 + 0.682171111) + 0.012522878) );
        SUN_DIRECT = ( vec3(f_END_DIRECT_R, f_END_DIRECT_G, f_END_DIRECT_B) * (vec3(f_END_DIRECT_R, f_END_DIRECT_G, f_END_DIRECT_B) * (vec3(f_END_DIRECT_R, f_END_DIRECT_G, f_END_DIRECT_B) * 0.305306011 + 0.682171111) + 0.012522878) );
        return;
    #elif defined DIMENSION_GENERIC
        SUN_AMBIENT = max(get_min_light(), ( fogColor.rgb * (fogColor.rgb * (fogColor.rgb * 0.305306011 + 0.682171111) + 0.012522878) ));
        SUN_DIRECT = vec3(0);
        return;
    #endif

    SUN_AMBIENT = vec3(f_SUNRISE_AMBIENT * sunriseStrength + f_NOON_AMBIENT * dayStrength + f_SUNSET_AMBIENT * sunsetStrength + (f_NIGHT_AMBIENT + nightVision / 4) * nightStrength);
    SUN_AMBIENT = ( SUN_AMBIENT * (SUN_AMBIENT * (SUN_AMBIENT * 0.305306011 + 0.682171111) + 0.012522878) );
    //SUN_AMBIENT = mix(SUN_AMBIENT, mix(SKY_TOP, SKY_GROUND, 0.7), 0.4);

    float LHeight = sin(sunAngleAtHome * PI * 2);

    if (LHeight > 0) {
        const vec3 SUNRISE_SUN = ( vec3(f_SUNRISE_RED, f_SUNRISE_GREEN, f_SUNRISE_BLUE) * (vec3(f_SUNRISE_RED, f_SUNRISE_GREEN, f_SUNRISE_BLUE) * (vec3(f_SUNRISE_RED, f_SUNRISE_GREEN, f_SUNRISE_BLUE) * 0.305306011 + 0.682171111) + 0.012522878) );
        const vec3 NOON_SUN = ( vec3(f_NOON_RED, f_NOON_GREEN, f_NOON_BLUE) * (vec3(f_NOON_RED, f_NOON_GREEN, f_NOON_BLUE) * (vec3(f_NOON_RED, f_NOON_GREEN, f_NOON_BLUE) * 0.305306011 + 0.682171111) + 0.012522878) );
        const vec3 SUNSET_SUN = ( vec3(f_SUNSET_RED, f_SUNSET_GREEN, f_SUNSET_BLUE) * (vec3(f_SUNSET_RED, f_SUNSET_GREEN, f_SUNSET_BLUE) * (vec3(f_SUNSET_RED, f_SUNSET_GREEN, f_SUNSET_BLUE) * 0.305306011 + 0.682171111) + 0.012522878) );

        SUN_DIRECT = SUNRISE_SUN * sunriseStrength + NOON_SUN * dayStrength + SUNSET_SUN * sunsetStrength;
    }
    else {
        SUN_DIRECT = ( vec3(f_MOON_RED, f_MOON_GREEN, f_MOON_BLUE) * (vec3(f_MOON_RED, f_MOON_GREEN, f_MOON_BLUE) * (vec3(f_MOON_RED, f_MOON_GREEN, f_MOON_BLUE) * 0.305306011 + 0.682171111) + 0.012522878) );

        const float MPI_DIV2 = MOON_PHASE_INFLUENCE / 2;
        float MoonPhaseFactor = cos(float(worldDay % 8) / 8.0 * TAU) * MPI_DIV2 + (1 - MPI_DIV2);
        SUN_DIRECT *= MoonPhaseFactor;
    }
    SUN_DIRECT *= smoothstep(0.0, 0.2, abs(LHeight)); // Fadeout to avoid harsh transition at sun rise/set

    float DesatFactor = 1 - rainStrength * 0.5;
    float DarkenFactor = 1 - rainStrength * 0.5;
    #ifdef IS_IRIS
        DesatFactor *= 1 - thunderStrength * 0.5;
        DarkenFactor *= 1 - thunderStrength * 0.75;
    #endif

    SUN_DIRECT = apply_saturation(SUN_DIRECT, DesatFactor) * DarkenFactor;
}
void init_colors() {
    get_sky_color();
    get_sun_color();
}
vec3 get_sun_glare(float Dist) {
    const vec3 SUN_GLARE = ( vec3(f_SUN_GLARE_R, f_SUN_GLARE_G, f_SUN_GLARE_B) * (vec3(f_SUN_GLARE_R, f_SUN_GLARE_G, f_SUN_GLARE_B) * (vec3(f_SUN_GLARE_R, f_SUN_GLARE_G, f_SUN_GLARE_B) * 0.305306011 + 0.682171111) + 0.012522878) );

    float DarkenFactor = 1 - rainStrength * RAIN_SKY_DARKENING;
    #ifdef IS_IRIS
        DarkenFactor *= 1 - thunderStrength * 0.75;
    #endif

    vec3 SunGlare = SUN_GLARE * DarkenFactor;
    float Visibility = sunsetStrength + sunriseStrength;
    Visibility = pow2(Visibility);

    return SunGlare * pow2(Dist * 0.5 + 0.5) * Visibility;
}
#ifdef DEFERRED
#else
#endif
vec2 tweak_lightmap_vertex(vec2 LightmapCoords, inout vec3 SunAmbient, inout vec3 SunDirect, vec3 ViewPosN, vec3 Normal, vec3 PlayerPos) {
    LightmapCoords = max(LightmapCoords * 1.06667 - 0.0625, 0);

    LightmapCoords.x = pow(LightmapCoords.x, 4.0001 - LM_FALLOFF_CURVE);

    #ifdef DIMENSION_OVERWORLD
        // Combine ambient lighting with the sky and some other tricks to make it less flat
        float NdotU = clamp(dot(gbufferModelView[1].xyz, Normal), -1, 1);
        vec3 SkyGround = SKY_GROUND + get_sun_glare(clamp(dot(Normal, sunPosN), -1, 1));
        SunAmbient = mix(SunAmbient, mix(SkyGround, SKY_TOP, NdotU * 0.5 + 0.5), 0.4);

        #ifdef IS_IRIS
            if(lightningBoltPosition.w > 0) {
                float VdotLi = 1 - min(1, distance(lightningBoltPosition.xyz, PlayerPos) * 0.01);
                vec3 LiBPN = normalize((player_view(lightningBoltPosition.xyz, false) - ViewPos));
                float NdotLi = max(0, dot(Normal, LiBPN)) * 0.8 + 0.2;
                SunAmbient += vec3(1) * NdotLi * VdotLi;
            }
        #endif
    #endif

    #ifdef HANDHELD_LIGHTS
        #ifdef IS_IRIS
            vec3 ViewPosOffset = player_view(PlayerPos + relativeEyePosition, false);
        #else
            vec3 ViewPosOffset = ViewPos;
        #endif
        float Dist = length(ViewPosOffset);

        float HandheldLight = max((heldBlockLightValue - Dist) / 15.0, 0);
        #ifndef GBUFFERS_BASIC
            HandheldLight *= max(0, dot(-normalize(ViewPosOffset), Normal));
        #endif
        HandheldLight = pow(HandheldLight, 4.0 - HANDHELD_FALLOFF_CURVE);
        LightmapCoords.x = max(LightmapCoords.x, HandheldLight);
    #endif

    #ifdef LM_FLICKER
        LightmapCoords.x *= (1 - LM_FLICKER_STRENGTH) + texture(noisetex, vec2(frameTimeCounter / 8, 0)).r * LM_FLICKER_STRENGTH;
    #endif

    #ifndef DIMENSION_OVERWORLD
        LightmapCoords.y = 1;
    #endif

    #if (defined DYNAMIC_SHADOWS) && (defined DIMENSION_OVERWORLD)
        SunDirect *= 1.2;
        SunAmbient *= 0.85;
    #endif

    return LightmapCoords;
}
attribute vec4 mc_Entity;
attribute vec2 mc_midTexCoord;
attribute vec4 at_tangent;
void init_generic() {
    init_colors();

    gl_Position = ftransform();
    texcoord = get_texcoord(gl_TextureMatrix[0], gl_MultiTexCoord0);
    LightmapCoords = get_lightmap(gl_TextureMatrix[1], gl_MultiTexCoord1);
    #ifdef GBUFFERS_BLOCK
        material = blockEntityId != 65535 ? blockEntityId : 0;
    #else
        material = mc_Entity.x;
    #endif    
    ViewPos = (gl_ModelViewMatrix * gl_Vertex).xyz;
    glcolor = gl_Color;

    Normal = normalize(gl_NormalMatrix * gl_Normal);
    #ifdef CHECK_GRASS_NORMALS
        if (material >= 10003 && material <= 10006) {
            Normal = gbufferModelView[1].xyz;
            // Make grass darker at the bottom. It looks better this way
            if (gl_MultiTexCoord0.t > mc_midTexCoord.t && (material == 10004 || material == 10005)) Normal *= 0.5;
        }
    #endif

    Tangent.xyz = gl_NormalMatrix * normalize(at_tangent.xyz + vec3(1e-9,0,0)); // Prevents nans when at_tangent is 0 (which can happen with some mods)
    Tangent.w = at_tangent.w;

    LightmapCoords = tweak_lightmap_vertex(LightmapCoords, SUN_AMBIENT, SUN_DIRECT, normalize(ViewPos), Normal, view_player(ViewPos, false));

    vec2 midcoord = mc_midTexCoord.xy;
    AtlasScale = abs(texcoord - midcoord) * 2;
    AtlasOffset = min(texcoord, 2 * midcoord - texcoord);
}
void main() {
	init_generic();
	#if TAA_MODE >= 2
    gl_Position.xy += taaJitter * gl_Position.w;
    #endif
}